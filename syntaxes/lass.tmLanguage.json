{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lass",
  "scopeName": "source.lass",
  "fileTypes": ["lass"],
  "uuid": "7e9c4f2a-8b3d-4e5f-9a1c-2d6b8c4e7f9a",
  "patterns": [
    {
      "comment": "Script Preamble with opening/closing --- delimiters (TypeScript by default)",
      "begin": "\\A---(\\s.*|-*)$",
      "end": "^---(\\s.*|-*)$",
      "beginCaptures": {
        "0": {
          "name": "comment.line.separator.lass"
        }
      },
      "endCaptures": {
        "0": {
          "name": "comment.line.separator.lass"
        }
      },
      "contentName": "meta.embedded.block.preamble.lass",
      "patterns": [
        {
          "include": "source.ts"
        }
      ]
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#fragment"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#property-accessor"
    },
    {
      "include": "#line-comment"
    },
    {
      "include": "source.css"
    }
  ],
  "injections": {
    "L:meta.property-value.css - (string, comment)": {
      "patterns": [
        {
          "include": "#property-accessor"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "L:meta.property-list.css - (string, comment)": {
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "#line-comment"
        }
      ]
    },
    "L:source.css - (string, comment)": {
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "#fragment"
        },
        {
          "include": "#line-comment"
        }
      ]
    },
    "L:meta.embedded.expression.lass": {
      "patterns": [
        {
          "include": "#fragment"
        }
      ]
    },
    "L:source.ts": {
      "patterns": [
        {
          "include": "#fragment"
        }
      ]
    }
  },
  "repository": {
    "lass-symbols": {
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "#fragment"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#property-accessor"
        },
        {
          "include": "#line-comment"
        }
      ]
    },
    "interpolation": {
      "comment": "{{ expr }} - TypeScript/JavaScript expression interpolation",
      "begin": "\\{\\{",
      "end": "\\}\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.begin.bracket.curly.lass"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.end.bracket.curly.lass"
        }
      },
      "contentName": "meta.embedded.expression.lass",
      "patterns": [
        {
          "include": "#fragment"
        },
        {
          "include": "source.ts"
        }
      ]
    },
    "fragment": {
      "comment": "@{ css } - CSS fragment block",
      "begin": "@\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.begin.bracket.curly.lass"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.end.bracket.curly.lass"
        }
      },
      "name": "meta.embedded.fragment.lass",
      "patterns": [
        {
          "include": "#lass-symbols"
        },
        {
          "include": "source.css"
        }
      ]
    },
    "variable": {
      "comment": "$param - Variable substitution",
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "variable.other.lass"
    },
    "property-accessor": {
      "comment": "@(prop) - Property lookup accessor (styled like CSS var())",
      "begin": "@\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "support.function.misc.lass"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.function.end.bracket.round.css"
        }
      },
      "patterns": [
        {
          "match": "[a-zA-Z-][a-zA-Z0-9-]*",
          "name": "support.constant.property-value.css"
        }
      ]
    },
    "line-comment": {
      "comment": "// Single-line comment (stripped from output)",
      "match": "//.*$",
      "name": "comment.line.double-slash.lass"
    }
  }
}
